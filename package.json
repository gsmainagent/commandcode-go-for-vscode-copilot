{
  "name": "commandcode-go-for-vscode-copilot",
  "displayName": "Command Code Go Copilot",
  "description": "Use the models included with the Command Code Go plan in GitHub Copilot Chat. The model list is discovered at runtime from the plan page — BYOK.",
  "icon": "resources/icon.png",
  "version": "0.2.4",
  "publisher": "gsmainagent",
  "author": "gsmainagent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gsmainagent/commandcode-go-for-vscode-copilot"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "commandcode",
    "command code go",
    "command code",
    "vscode",
    "copilot",
    "github copilot",
    "copilot chat",
    "vision",
    "byok",
    "language model",
    "thinking",
    "reasoning",
    "ai",
    "chat"
  ],
  "activationEvents": [
    "onUri",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "commandcode",
        "displayName": "Command Code Go"
      }
    ],
    "commands": [
      {
        "command": "commandcode-copilot.setApiKey",
        "title": "%commandcode-copilot.command.setApiKey%"
      },
      {
        "command": "commandcode-copilot.getApiKey",
        "title": "%commandcode-copilot.command.getApiKey%"
      },
      {
        "command": "commandcode-copilot.clearApiKey",
        "title": "%commandcode-copilot.command.clearApiKey%"
      },
      {
        "command": "commandcode-copilot.openSettings",
        "title": "%commandcode-copilot.command.openSettings%"
      },
      {
        "command": "commandcode-copilot.showLogs",
        "title": "%commandcode-copilot.command.showLogs%"
      },
      {
        "command": "commandcode-copilot.refreshModels",
        "title": "%commandcode-copilot.command.refreshModels%"
      }
    ],
    "walkthroughs": [
      {
        "id": "commandcodeGettingStarted",
        "title": "%commandcode-copilot.walkthrough.title%",
        "description": "%commandcode-copilot.walkthrough.description%",
        "steps": [
          {
            "id": "setApiKey",
            "title": "%commandcode-copilot.walkthrough.setApiKey.title%",
            "description": "%commandcode-copilot.walkthrough.setApiKey.description%",
            "media": {
              "markdown": "resources/walkthrough/set-api-key.md"
            },
            "completionEvents": [
              "onCommand:commandcode-copilot.setApiKey"
            ]
          },
          {
            "id": "showModels",
            "title": "%commandcode-copilot.walkthrough.showModels.title%",
            "description": "%commandcode-copilot.walkthrough.showModels.description%",
            "media": {
              "markdown": "resources/walkthrough/show-models.md"
            }
          },
          {
            "id": "advancedSettings",
            "title": "%commandcode-copilot.walkthrough.advancedSettings.title%",
            "description": "%commandcode-copilot.walkthrough.advancedSettings.description%",
            "media": {
              "markdown": "resources/walkthrough/advanced-settings.md"
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%commandcode-copilot.config.title%",
      "properties": {
        "commandcode-copilot.maxTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "%commandcode-copilot.config.maxTokens.description%"
        },
        "commandcode-copilot.zdr": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%commandcode-copilot.config.zdr.description%"
        },
        "commandcode-copilot.apiKey": {
          "type": "string",
          "description": "%commandcode-copilot.config.apiKey.description%"
        },
        "commandcode-copilot.catalogBaseUrl": {
          "type": "string",
          "default": "https://api.commandcode.ai/provider/v1",
          "markdownDescription": "%commandcode-copilot.config.catalogBaseUrl.description%"
        },
        "commandcode-copilot.generateBaseUrl": {
          "type": "string",
          "default": "https://api.commandcode.ai/alpha",
          "markdownDescription": "%commandcode-copilot.config.generateBaseUrl.description%"
        },
        "commandcode-copilot.planBaseUrl": {
          "type": "string",
          "default": "https://commandcode.ai/docs/plans",
          "markdownDescription": "%commandcode-copilot.config.planBaseUrl.description%"
        },
        "commandcode-copilot.cliReferenceBaseUrl": {
          "type": "string",
          "default": "https://commandcode.ai/docs/reference/cli",
          "markdownDescription": "%commandcode-copilot.config.cliReferenceBaseUrl.description%"
        },
        "commandcode-copilot.modelSource": {
          "type": "string",
          "default": "dynamic",
          "enum": [
            "dynamic",
            "static"
          ],
          "enumItemLabels": [
            "%commandcode-copilot.config.modelSource.dynamic.label%",
            "%commandcode-copilot.config.modelSource.static.label%"
          ],
          "markdownEnumDescriptions": [
            "%commandcode-copilot.config.modelSource.dynamic.description%",
            "%commandcode-copilot.config.modelSource.static.description%"
          ],
          "markdownDescription": "%commandcode-copilot.config.modelSource.description%"
        },
        "commandcode-copilot.modelBlacklist": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%commandcode-copilot.config.modelBlacklist.description%"
        },
        "commandcode-copilot.maxContextTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%commandcode-copilot.config.maxContextTokens.description%"
        },
        "commandcode-copilot.debugMode": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "metadata",
            "verbose"
          ],
          "enumItemLabels": [
            "%commandcode-copilot.config.debugMode.minimal.label%",
            "%commandcode-copilot.config.debugMode.metadata.label%",
            "%commandcode-copilot.config.debugMode.verbose.label%"
          ],
          "markdownEnumDescriptions": [
            "%commandcode-copilot.config.debugMode.minimal.description%",
            "%commandcode-copilot.config.debugMode.metadata.description%",
            "%commandcode-copilot.config.debugMode.verbose.description%"
          ],
          "markdownDescription": "%commandcode-copilot.config.debugMode.description%"
        },
        "commandcode-copilot.catalogRefreshMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "markdownDescription": "%commandcode-copilot.config.catalogRefreshMinutes.description%"
        },
        "commandcode-copilot.upstreamProxy": {
          "type": "string",
          "default": "",
          "markdownDescription": "%commandcode-copilot.config.upstreamProxy.description%"
        }
      }
    }
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p tsconfig.test.json && node --test '.test-build/test/*.test.js'",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "oxfmt --write src/ test/",
    "format:check": "oxfmt --check src/ test/",
    "verify:proxy": "node tools/vendor-proxy.mjs --check",
    "vendor:proxy": "node tools/vendor-proxy.mjs",
    "package": "npm run verify:proxy && npm run compile && mkdir -p dist && vsce package --no-dependencies -o dist/command-code-go-for-github-copilot.vsix"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.116.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^10.8.1",
    "oxfmt": "^0.47.0",
    "typescript": "^6.0.3"
  }
}
